# Copy to .env; never commit credentials.
POSTGRES_DB=wellwatch
POSTGRES_USER=wellwatch
POSTGRES_PASSWORD=replace-with-random-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
DJANGO_SECRET_KEY=replace-with-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
TZ=Asia/Kolkata
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=wellness@example.test
HR_EMAIL=
