# Copy to .env; never commit credentials.
POSTGRES_DB=wellwatch
POSTGRES_USER=wellwatch
POSTGRES_PASSWORD=replace-with-random-password
DJANGO_SECRET_KEY=replace-with-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TZ=Asia/Kolkata
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=wellness@example.com
HR_EMAIL=hr@example.com
