# Copy to .env; never commit credentials.

# --- PostgreSQL ---
# Windows (setup-local.ps1): use port 55432
# macOS (Homebrew postgresql@18): use port 5432
POSTGRES_DB=wellwatch
POSTGRES_USER=wellwatch
POSTGRES_PASSWORD=replace-with-random-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=replace-with-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
TZ=Asia/Kolkata

# --- Demo accounts (generated by seed_demo, stored in .local/demo-accounts.json) ---
# Managers  : demo.ishaan@example.test / demo.neha@example.test
# Employees : demo.aarav@example.test  / demo.priya@example.test  / demo.rohan@example.test
#             demo.ananya@example.test / demo.vikram@example.test / demo.meera@example.test
#             demo.arjun@example.test  / demo.kavya@example.test  / demo.aditya@example.test
#             demo.sana@example.test
# Admin     : admin@wellwatch.local  (created manually — see README)
# Passwords are set via manage.py shell or seed commands; do not store real passwords here.

